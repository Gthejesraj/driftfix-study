-class BankCodeValidationError(PydanticValueError):
+class ClabeValidationError(ValueError):
+    """
+    Base class for CLABE validation errors.
+
+    Replaces `pydantic.errors.PydanticValueError`, which was removed in
+    pydantic v2. Raising a plain `ValueError` subclass from within a
+    validator is the way pydantic v2 expects custom errors to be
+    signalled, and it keeps these exceptions usable outside of pydantic.
+    """
+
+    code: str = 'clabe.invalid'
+    msg_template: str = 'clabe no es válida'
+
+    def __init__(self, **ctx: Any) -> None:
+        self.ctx: Dict[str, Any] = ctx
+        super().__init__(self.msg_template.format(**ctx))
+
+
+class NotDigitError(ClabeValidationError):
+    code = 'clabe.not_digit'
+    msg_template = 'el valor no es un string de dígitos'
+
+
+class BankCodeValidationError(ClabeValidationError):
     code = 'clabe.bank_code'
     msg_template = 'código de banco no es válido'
 
 
-class ClabeControlDigitValidationError(PydanticValueError):
+class ClabeControlDigitValidationError(ClabeValidationError):
     code = 'clabe.control_digit'
     msg_template = 'clabe dígito de control no es válido'
