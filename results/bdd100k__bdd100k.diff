diff --git a/bdd100k/common/pydantic_compat.py b/bdd100k/common/pydantic_compat.py
new file mode 100644
index 0000000..df73697
--- /dev/null
+++ b/bdd100k/common/pydantic_compat.py
@@ -0,0 +1,52 @@
+"""Compatibility helpers for pydantic v2.
+
+Pydantic v1 implicitly gave every ``Optional[...]`` model field a default
+value of ``None``, so a field annotated as optional could be omitted when
+constructing or parsing a model. Pydantic v2 dropped that behaviour: a field
+is only optional if it declares a default explicitly.
+
+The models shared with the toolkit by ``scalabel`` (``Frame``, ``Config``,
+``Category``, ...) still rely on the old behaviour, which makes loading
+BDD100K annotation and configuration files fail with "Field required"
+validation errors. The helper below restores the pydantic v1 semantics for
+those models by giving every nullable field without a default a ``None``
+default.
+"""
+
+import types
+from typing import Union, get_args, get_origin
+
+from pydantic import BaseModel
+
+
+def _allows_none(annotation: object) -> bool:
+    """Check whether a field annotation accepts ``None``."""
+    if annotation is None or annotation is type(None):
+        return True
+    origin = get_origin(annotation)
+    if origin is Union or origin is getattr(types, "UnionType", Union):
+        return any(_allows_none(arg) for arg in get_args(annotation))
+    return False
+
+
+def optional_fields_default_to_none(module: types.ModuleType) -> None:
+    """Give nullable fields of a module's models a ``None`` default."""
+    models = [
+        obj
+        for obj in vars(module).values()
+        if isinstance(obj, type)
+        and issubclass(obj, BaseModel)
+        and obj is not BaseModel
+        and obj.__module__ == module.__name__
+    ]
+    patched = False
+    for model in models:
+        for field in model.model_fields.values():
+            if field.is_required() and _allows_none(field.annotation):
+                field.default = None
+                patched = True
+    if patched:
+        # models may share inherited field definitions, so regenerate the
+        # validation schema of all of them with the new defaults
+        for model in models:
+            model.model_rebuild(force=True)
