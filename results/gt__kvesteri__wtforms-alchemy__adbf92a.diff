diff --git a/tests/test_i18n_extension.py b/tests/test_i18n_extension.py
index 142b5f0..70e82e8 100644
--- a/tests/test_i18n_extension.py
+++ b/tests/test_i18n_extension.py
@@ -1,10 +1,32 @@
 import sqlalchemy as sa
 from pytest import raises
 from sqlalchemy_i18n import make_translatable, Translatable, translation_base
+from sqlalchemy_i18n.comparators import TranslationComparator
 
 from tests import ModelFormTestCase, MultiDict
 from wtforms_alchemy import ModelForm
 
+
+def _patch_translation_comparator():
+    """
+    SQLAlchemy 2.1 probes its mapped attributes for private attributes such as
+    ``_slots_dispatch`` with :func:`hasattr`. SQLAlchemy-i18n (1.1.0) turns
+    every failed attribute lookup on a translation comparator into an
+    ``UnknownLocaleError``, which makes those probes blow up during mapper
+    configuration. Locales are never private attribute names, so let such
+    lookups raise ``AttributeError`` as :func:`hasattr` expects.
+    """
+    original = TranslationComparator.__getattr__
+
+    def __getattr__(self, locale):
+        if locale.startswith('_'):
+            raise AttributeError(locale)
+        return original(self, locale)
+
+    TranslationComparator.__getattr__ = __getattr__
+
+
+_patch_translation_comparator()
 make_translatable()
 
 
