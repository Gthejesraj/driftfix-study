diff --git a/wtforms_alchemy/sa_compat.py b/wtforms_alchemy/sa_compat.py
new file mode 100644
index 0000000..ca2f6f8
--- /dev/null
+++ b/wtforms_alchemy/sa_compat.py
@@ -0,0 +1,31 @@
+"""
+Compatibility helpers for the SQLAlchemy versions supported by
+WTForms-Alchemy.
+
+Importing this module applies the patches, so it has to be imported before
+any other module that imports ``sqlalchemy_utils``.
+"""
+from sqlalchemy.orm import attributes
+
+#: SQLAlchemy 2.1 made the attribute implementation classes private by
+#: renaming them with a leading underscore. SQLAlchemy-Utils (0.42.1 and
+#: earlier) still subclasses ``attributes.ScalarAttributeImpl`` at import
+#: time, which means ``import sqlalchemy_utils`` fails with SQLAlchemy 2.1.
+#: Until a SQLAlchemy 2.1 compatible SQLAlchemy-Utils is released we restore
+#: the pre-2.1 aliases so that the library remains importable.
+RENAMED_ATTRIBUTE_IMPLS = (
+    'AttributeImpl',
+    'CollectionAttributeImpl',
+    'ScalarAttributeImpl',
+    'ScalarObjectAttributeImpl',
+)
+
+
+def restore_attribute_impl_aliases():
+    for name in RENAMED_ATTRIBUTE_IMPLS:
+        private = getattr(attributes, '_%s' % name, None)
+        if private is not None and not hasattr(attributes, name):
+            setattr(attributes, name, private)
+
+
+restore_attribute_impl_aliases()
