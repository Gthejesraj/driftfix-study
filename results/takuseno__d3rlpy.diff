diff --git a/d3rlpy/_gym_compat.py b/d3rlpy/_gym_compat.py
new file mode 100644
index 0000000..9bdcf20
--- /dev/null
+++ b/d3rlpy/_gym_compat.py
@@ -0,0 +1,31 @@
+"""Compatibility patches for the legacy ``gym`` package.
+
+``gym`` has been archived at v0.26.2 and still refers to aliases that NumPy
+removed in v2.0 (see the NumPy 2.0 migration guide).  Since d3rlpy keeps
+supporting legacy ``gym`` environments alongside Gymnasium ones, the removed
+aliases are restored here so that stepping a ``gym`` environment does not raise
+``AttributeError`` under NumPy>=2.
+
+This is a no-op with NumPy<2 and when ``gym`` is not installed.
+"""
+
+import numpy as np
+
+__all__ = ["patch_gym_numpy_aliases"]
+
+# aliases removed in NumPy 2.0 that are still referenced by gym==0.26.2
+_REMOVED_ALIASES = {
+    "bool8": np.bool_,  # gym.utils.passive_env_checker
+    "float_": np.float64,  # gym.envs.classic_control.acrobot
+}
+
+
+def patch_gym_numpy_aliases() -> None:
+    try:
+        import gym  # noqa: F401
+    except ImportError:
+        return
+
+    for name, alias in _REMOVED_ALIASES.items():
+        if not hasattr(np, name):
+            setattr(np, name, alias)
