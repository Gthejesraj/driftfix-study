diff --git a/src/phantom/_pydantic.py b/src/phantom/_pydantic.py
new file mode 100644
index 0000000..4dad83a
--- /dev/null
+++ b/src/phantom/_pydantic.py
@@ -0,0 +1,106 @@
+"""
+Glue code for pydantic integration.
+
+As pydantic is an optional dependency, this module must stay importable without it
+installed, so pydantic is only imported from within the functions that need it. Those
+functions are in turn only called from the ``__get_pydantic_core_schema__()`` and
+``__get_pydantic_json_schema__()`` hooks, which pydantic itself invokes.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import TypeVar
+
+from ._utils.misc import fully_qualified_name
+
+if TYPE_CHECKING:
+    from pydantic import GetCoreSchemaHandler
+    from pydantic import GetJsonSchemaHandler
+    from pydantic.json_schema import JsonSchemaValue
+    from pydantic_core import CoreSchema
+
+    from ._base import PhantomBase
+    from .schema import SchemaField
+
+__all__ = ("parsed_schema", "phantom_core_schema", "phantom_json_schema")
+
+Derived = TypeVar("Derived", bound="PhantomBase")
+
+
+def parsed_schema(type_: type[Derived], representation: CoreSchema) -> CoreSchema:
+    """
+    Build a core schema that first validates the runtime representation of a phantom
+    type, and then narrows the validated value using the type's
+    :func:`parse() <phantom.PhantomBase.parse>` method.
+    """
+    from pydantic_core import core_schema
+
+
+    def parse(value: Any) -> Derived:
+        try:
+            return type_.parse(value)
+        except TypeError as exception:
+            # pydantic only translates ValueError and AssertionError into validation
+            # errors, so TypeError raised by parse() needs to be converted.
+            raise ValueError(
+                str(exception)
+                or f"Could not parse {fully_qualified_name(type_)} from {value!r}"
+            ) from exception
+
+    return core_schema.no_info_after_validator_function(parse, representation)
+
+
+def representation_schema(
+    type_: type[PhantomBase],
+    handler: GetCoreSchemaHandler,
+) -> CoreSchema:
+    """
+    Build a core schema for the runtime representation of a phantom type, by inspecting
+    its bound. Bounds that pydantic cannot describe, such as protocols, result in a
+    schema that accepts any value, leaving all validation to the type's parse method.
+    """
+    from pydantic import PydanticSchemaGenerationError
+    from pydantic_core import core_schema
+
+    bound = getattr(type_, "__bound__", None)
+    # A bound can be an intersection, represented as a sequence of types. The first type
+    # of such a sequence is the most derived one, and hence the best candidate for
+    # describing the runtime representation. Narrowing is in any case guaranteed by
+    # parse(), which checks values against the full bound.
+    candidates = bound if isinstance(bound, tuple) else (bound,)
+    for candidate in candidates:
+        # Protocols and non-types, such as unions, cannot be described by pydantic.
+        if not isinstance(candidate, type) or getattr(candidate, "_is_protocol", False):
+            continue
+        try:
+            return handler.generate_schema(candidate)
+        except PydanticSchemaGenerationError:
+            continue
+    return core_schema.any_schema()
+
+
+def phantom_core_schema(
+    type_: type[Derived],
+    handler: GetCoreSchemaHandler,
+) -> CoreSchema:
+    """Build the core schema of a phantom type."""
+    return parsed_schema(type_, representation_schema(type_, handler))
+
+
+def phantom_json_schema(
+    type_: type[SchemaField],
+    schema: CoreSchema,
+    handler: GetJsonSchemaHandler,
+) -> JsonSchemaValue:
+    """
+    Build the JSON schema of a phantom type, by applying the overrides provided by
+    :func:`__schema__() <phantom.Phantom.__schema__>` on top of the JSON schema of its
+    runtime representation.
+    """
+    json_schema = handler(schema)
+    json_schema.update(
+        {key: value for key, value in type_.__schema__().items() if value is not None}
+    )
+    return json_schema
