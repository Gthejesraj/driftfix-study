+def model_to_json(
+    model: BaseModel, exclude_none: bool = False, sort_keys: bool = False
+) -> str:
+    """
+    Serializes a pydantic model to a JSON string.
+
+    pydantic v2 dropped support for passing `json.dumps` keyword arguments
+    (such as `sort_keys`) through to the model serializer, so dump to a
+    JSON-compatible dict first and then encode it ourselves.
+    """
+    return json.dumps(
+        model.model_dump(mode="json", exclude_none=exclude_none),
+        sort_keys=sort_keys,
+    )
+
 
