+    def render_python_type(self, python_type: type) -> str:
+        """
+        Return the name to use in annotations for the given Python type, adding the
+        necessary import.
+
+        Types outside of ``builtins`` are rendered using their fully qualified name
+        (e.g. ``uuid.UUID``) to avoid clashes with the SQLAlchemy type names imported
+        in the generated module.
