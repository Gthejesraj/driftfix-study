--- a/ezcharts/plots/_base.py
+++ b/ezcharts/plots/_base.py
@@ -2,7 +2,7 @@
 
 import numpy as np
 import pandas as pd
-from pydantic import BaseModel as PyDanticBase, Extra
+from pydantic import BaseModel as PyDanticBase, ConfigDict
 
 from ezcharts.plots.util import JSCode
 
@@ -14,11 +14,31 @@ json_encoders = {
     JSCode: lambda x: x.to_json()}
 
 
-class BaseModel(
-        PyDanticBase, extra=Extra.forbid, validate_assignment=True,
-        json_encoders=json_encoders, arbitrary_types_allowed=True):
+def json_fallback(value):
+    """Serialise values that pydantic doesn't know how to handle.
+
+    Most fields of the eCharts model are typed as `Any`, so pydantic cannot
+    infer a serializer for the (third-party) objects which users store in
+    them. This function is handed to pydantic's `fallback` serialization
+    hook to deal with those cases.
+
+    :param value: object which pydantic could not serialise.
+    :returns: a JSON-serialisable representation of `value`.
+    """
+    for type_, encoder in json_encoders.items():
+        if isinstance(value, type_):
+            return encoder(value)
+    raise TypeError(
+        f"Cannot JSON serialise object of type {type(value)}.")
+
+
+class BaseModel(PyDanticBase):
     """Base class for eCharts Options."""
     # Note: this class's name in referenced in generate-model.py
     # TODO: can we overide getting of attributes to allow
     #       allow setting of children when parent isn't set.
     #       Simple __getattr__ isn't called :(
+
+    model_config = ConfigDict(
+        extra="forbid", validate_assignment=True,
+        arbitrary_types_allowed=True)
