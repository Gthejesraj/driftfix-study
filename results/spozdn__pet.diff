diff --git a/src/ase_compat.py b/src/ase_compat.py
new file mode 100644
index 0000000..09f9139
--- /dev/null
+++ b/src/ase_compat.py
@@ -0,0 +1,49 @@
+"""Compatibility helpers for reading reference data from ASE structures.
+
+Up to ASE 3.22, ``ase.io.read`` stored every field of an extended xyz file in
+``atoms.info`` (per structure) and ``atoms.arrays`` (per atom).  Since ASE 3.23
+the fields that correspond to standard calculator properties (``energy``,
+``forces``, ``stress``, ...) are instead attached to the structure as the
+results of a ``SinglePointCalculator``, and they are no longer present in
+``atoms.info`` / ``atoms.arrays``.
+
+The helpers below look in both places, so that PET works with old and new
+versions of ASE regardless of where the reference values end up.
+"""
+
+
+def _calculator_results(atoms):
+    calculator = getattr(atoms, "calc", None)
+    if calculator is None:
+        return {}
+    return getattr(calculator, "results", None) or {}
+
+
+def has_structural_property(atoms, key):
+    """Whether a per-structure property is available under the given key."""
+    return key in atoms.info or key in _calculator_results(atoms)
+
+
+def get_structural_property(atoms, key):
+    """Per-structure property, from ``atoms.info`` or from the calculator."""
+    if key in atoms.info:
+        return atoms.info[key]
+    results = _calculator_results(atoms)
+    if key in results:
+        return results[key]
+    raise KeyError(key)
+
+
+def has_atomic_property(atoms, key):
+    """Whether a per-atom property is available under the given key."""
+    return key in atoms.arrays or key in _calculator_results(atoms)
+
+
+def get_atomic_property(atoms, key):
+    """Per-atom property, from ``atoms.arrays`` or from the calculator."""
+    if key in atoms.arrays:
+        return atoms.arrays[key]
+    results = _calculator_results(atoms)
+    if key in results:
+        return results[key]
+    raise KeyError(key)
